# ==============================================================================
# SHREE GANESHA SOLAR - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with real values for production.
# NEVER commit .env to public version control.
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=production

# Staff Lead Management Portal Subdomain Routing
# Subdomain prefix for staff management (e.g. admin or staff or portal)
ADMIN_SUBDOMAIN=admin
# Apex production domain name (without protocol or subdomains)
APP_DOMAIN=shreeganeshasolar.com

# Admin Lead Management Portal Access Key
# Protects portal access and all /api/admin/* endpoints
ADMIN_SECRET_KEY=replace_with_strong_random_secret_for_staff

# IP Anonymization Salt (Used to generate privacy-compliant rate limit hashes)
HASH_SALT=replace_with_random_salt_for_ip_hashing

# Optional Google Analytics & Ads Tracking Configuration
# (Can also be set in tag manager container)
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX
# GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX/quote_lead

# Optional External Database Adapter (Defaults to local SQLite if omitted)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
